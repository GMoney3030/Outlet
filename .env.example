# Server
PORT=3000

# Outlet Liquors site to scrape for product intel
OUTLET_LIQUORS_URL=https://www.outletliquors.com
OUTLET_LIQUORS_CATALOG_PATH=/shop
CATALOG_CACHE_TTL_MINUTES=60

# Gmail OAuth (see README for setup)
GMAIL_USER=orders@yourdomain.com
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./data/token.json

# Discounts
CASE_DISCOUNT_PERCENT=10
CASE_SIZE=12
WEDDING_DISCOUNT_PERCENT=15
WEDDING_DISCOUNT_MIN_GUESTS=50

# Pickup scheduling
PICKUP_LEAD_DAYS=7
